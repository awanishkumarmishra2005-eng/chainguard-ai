# Local live mode. Set DEMO_MODE=true only when you intentionally want synthetic data.
DEMO_MODE=false
# Keep false for hosted/public deployments. Enable only for an authorized local
# or disposable test environment that intentionally writes graph data.
ALLOW_GRAPH_WRITES=false

# Preferred hosted/local connection form. Use falkors:// or rediss:// for TLS.
# Example only; do not put a real password in this file.
FALKORDB_URL=

# Local fallback when FALKORDB_URL is empty.
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH_NAME=ChainGuard
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_TLS=false
FALKORDB_SSL_CERT_REQS=required
FALKORDB_SSL_CA_CERTS=
FALKORDB_CONNECT_TIMEOUT=5
FALKORDB_SOCKET_TIMEOUT=10

# Optional legacy aliases accepted by the app when the FALKORDB_* names are absent:
# DB_URL, DB_HOST, DB_PORT, GRAPH_NAME, DB_USERNAME, DB_PASSWORD, DB_TLS

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
